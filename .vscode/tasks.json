{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build & Run Chirpy",
      "type": "shell",
      "command": "lsof -ti:8080 | xargs kill 2>/dev/null; go build -o out . && ./out",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build Chirpy",
      "type": "shell",
      "command": "go build -o out .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": ["$go"]
    }
  ]
}
